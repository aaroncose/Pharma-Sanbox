# ─────────────────────────────────────────────────────────────────────────────
# Pharma Commercial AI Sandbox — plantilla de configuración
# Copiar a .env y ajustar. NUNCA commitear .env.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
APP_NAME="Pharma Commercial AI Sandbox"
LOG_LEVEL=INFO

# ── Base de datos ────────────────────────────────────────────────────────────
# DATABASE_URL usa el rol de aplicación: NO es superusuario y NO tiene BYPASSRLS.
# Es lo que hace que Row-Level Security sea real y no decorativa.
DATABASE_URL=postgresql+psycopg://pharma_app:pharma_app_dev@localhost:5432/pharma_sandbox
# MIGRATION_DATABASE_URL usa el rol propietario: crea tablas y políticas RLS.
MIGRATION_DATABASE_URL=postgresql+psycopg://pharma_owner:pharma_owner_dev@localhost:5432/pharma_sandbox

# ── Redis (colas, caché, rate limiting) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Seguridad ────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIAR_ESTE_VALOR_EN_CUALQUIER_ENTORNO_QUE_NO_SEA_LOCAL
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
# Clave de cifrado en reposo para campos sensibles (Fernet, 32 bytes url-safe b64).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Proveedor de IA ──────────────────────────────────────────────────────────
# Si ANTHROPIC_API_KEY está vacía, el sistema usa el proveedor mock determinista.
# La demo funciona íntegra en ambos modos.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_PRIMARY_MODEL=claude-opus-4-8
LLM_VERIFIER_MODEL=claude-haiku-4-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ── Almacenamiento de documentos ─────────────────────────────────────────────
# Compatible S3. En local se usa el backend de sistema de ficheros.
STORAGE_BACKEND=filesystem
STORAGE_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Políticas operativas ─────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=365
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AGENT_PER_MINUTE=10

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010

# Puerto de la API. El 8000 está ocupado por otro servicio en esta máquina.
API_PORT=8010
